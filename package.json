{
  "name": "@legotin/agent-badge-workspace",
  "private": true,
  "description": "Workspace for the local-first agent-badge CLI and npm initializer.",
  "type": "module",
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest",
    "typecheck": "tsc -b --pretty false packages/core/tsconfig.json packages/agent-badge/tsconfig.json packages/create-agent-badge/tsconfig.json packages/testkit/tsconfig.json",
    "verify:clean-checkout": "node scripts/validation/run-isolated.mjs node scripts/validation/verify-clean-checkout.mjs",
    "pack:check": "node scripts/check-packages.mjs",
    "smoke:pack": "node scripts/smoke/verify-packed-install.mjs",
    "smoke:registry": "node scripts/validation/run-isolated.mjs node scripts/smoke/verify-initializer-install.mjs",
    "docs:check": "node --import tsx scripts/verify-docs.mjs",
    "changeset": "changeset",
    "release": "node --import tsx scripts/release/preflight.ts",
    "release:publish-impact": "tsx scripts/release/publish-impact.ts",
    "release:preflight": "node --import tsx scripts/release/preflight.ts",
    "release:evidence": "node --import tsx scripts/release/capture-publish-evidence.ts",
    "dev:agent-badge": "tsx packages/agent-badge/src/cli/main.ts",
    "dev:create-agent-badge": "tsx packages/create-agent-badge/src/index.ts",
    "verify:isolated": "node scripts/validation/run-isolated.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.0",
    "js-yaml": "4.1.1"
  },
  "license": "Apache-2.0"
}
